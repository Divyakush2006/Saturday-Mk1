# Saturday MK1 configuration. Copy to .env and fill in the values you need.

# Persistence (Neon / PostgreSQL connection string)
DATABASE_URL=

# LLM provider (OpenAI-compatible endpoint by default)
SATURDAY_PROVIDER=openai
SATURDAY_API_BASE=https://api.openai.com/v1
SATURDAY_API_KEY=
SATURDAY_MODEL=gpt-4o

# Inference tuning (optional; defaults shown)
SATURDAY_MAX_RETRIES=3
SATURDAY_TIMEOUT=120
SATURDAY_MAX_TOKENS=4096
SATURDAY_TEMPERATURE=0.2

# Security
# Key clients must present to call the API server (leave empty to disable)
SATURDAY_SERVER_KEY=
# Secret used to sign authentication tokens
SATURDAY_JWT_SECRET=
